---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Engenharia que integra meio ambiente, automação e geoprocessamento." } = Astro.props;

const siteUrl = 'https://beleligeoengenharia.com.br';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = `${siteUrl}/og-image.png`;
const fullTitle = `${title} | Beleli GeoEngenharia`;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beleli GeoEngenharia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Analytics 4 (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CWCGCECMWH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CWCGCECMWH');
    </script>
  </head>

  <body class="min-h-screen flex flex-col">

    <header class="bg-azul text-white relative z-50">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/">
          <img src="/logo.svg" alt="Beleli GeoEngenharia" class="h-30" />
        </a>

        <!-- Nav desktop -->
        <nav class="hidden md:flex gap-6 text-sm font-medium items-center">
          <a href="/" class="hover:text-terracota transition-colors">Início</a>

          <!-- Dropdown Serviços -->
          <div class="relative group">
            <button type="button" class="hover:text-terracota transition-colors flex items-center gap-1 cursor-pointer py-2" aria-haspopup="true">
              Serviços
              <svg class="w-3 h-3 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block min-w-56 z-50">
              <div class="bg-azul border-t border-white/10 shadow-lg rounded-b">
                <a href="/servicos" class="block px-4 py-3 hover:bg-white/10 hover:text-terracota transition-colors">Visão geral</a>
                <a href="/seguranca-do-trabalho" class="block px-4 py-3 hover:bg-white/10 hover:text-terracota transition-colors">Segurança do Trabalho</a>
                <a href="/regularizacao-de-estabelecimentos" class="block px-4 py-3 hover:bg-white/10 hover:text-terracota transition-colors">Regularização</a>
              </div>
            </div>
          </div>

          <a href="/galeria" class="hover:text-terracota transition-colors">Galeria</a>
          <a href="/estudos-tecnicos" class="hover:text-terracota transition-colors">Estudos Técnicos</a>
          <a href="/ferramentas" class="hover:text-terracota transition-colors">Ferramentas</a>
          <a href="/sobre" class="hover:text-terracota transition-colors">Sobre</a>
          <a href="/contato" class="hover:text-terracota transition-colors">Contato</a>
        </nav>

        <!-- Botão hambúrguer (só no mobile) -->
        <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menu">
          <span class="block w-6 h-0.5 bg-white transition-all" id="linha1"></span>
          <span class="block w-6 h-0.5 bg-white transition-all" id="linha2"></span>
          <span class="block w-6 h-0.5 bg-white transition-all" id="linha3"></span>
        </button>
      </div>

      <!-- Menu mobile -->
      <div id="menu-mobile" class="hidden md:hidden bg-azul border-t border-white/10">
        <nav class="flex flex-col px-6 py-4 gap-4 text-sm font-medium">
          <a href="/" class="hover:text-terracota transition-colors">Início</a>

          <details class="group/dropdown">
            <summary class="hover:text-terracota transition-colors cursor-pointer flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
              <span>Serviços</span>
              <svg class="w-3 h-3 transition-transform group-open/dropdown:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="pl-4 pt-3 flex flex-col gap-3 border-l border-white/10 ml-1 mt-2">
              <a href="/servicos" class="hover:text-terracota transition-colors">Visão geral</a>
              <a href="/seguranca-do-trabalho" class="hover:text-terracota transition-colors">Segurança do Trabalho</a>
              <a href="/regularizacao-de-estabelecimentos" class="hover:text-terracota transition-colors">Regularização</a>
            </div>
          </details>

          <a href="/galeria" class="hover:text-terracota transition-colors">Galeria</a>
          <a href="/estudos-tecnicos" class="hover:text-terracota transition-colors">Estudos Técnicos</a>
          <a href="/ferramentas" class="hover:text-terracota transition-colors">Ferramentas</a>
          <a href="/sobre" class="hover:text-terracota transition-colors">Sobre</a>
          <a href="/contato" class="hover:text-terracota transition-colors">Contato</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-azul-dark text-white/70 text-sm">
      <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col md:flex-row justify-between gap-4">
        <div>
          <p class="font-semibold text-white">Beleli GeoEngenharia</p>
          <p>Engenharia que integra meio ambiente, automação e geoprocessamento.</p>
        </div>

        <div class="text-right">
          <p>
            <a
              href="https://wa.me/5518997116392"
              target="_blank"
              rel="noopener"
              class="hover:text-white transition-colors"
            >
              (18) 99711-6392
            </a>
          </p>
          <p>contato@beleligeoengenharia.com.br</p>
          <p>© {new Date().getFullYear()} Beleli GeoEngenharia</p>
        </div>
      </div>
    </footer>

  </body>
</html>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-mobile');
  const linha1 = document.getElementById('linha1');
  const linha2 = document.getElementById('linha2');
  const linha3 = document.getElementById('linha3');

  btn?.addEventListener('click', () => {
    const aberto = menu?.classList.toggle('hidden') === false;

    if (aberto) {
      linha1?.classList.add('rotate-45', 'translate-y-2');
      linha2?.classList.add('opacity-0');
      linha3?.classList.add('-rotate-45', '-translate-y-2');
    } else {
      linha1?.classList.remove('rotate-45', 'translate-y-2');
      linha2?.classList.remove('opacity-0');
      linha3?.classList.remove('-rotate-45', '-translate-y-2');
    }
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      linha1?.classList.remove('rotate-45', 'translate-y-2');
      linha2?.classList.remove('opacity-0');
      linha3?.classList.remove('-rotate-45', '-translate-y-2');
    });
  });
</script>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });

  document.querySelectorAll('.fade-in-up').forEach((el) => {
    observer.observe(el);
  });
</script>